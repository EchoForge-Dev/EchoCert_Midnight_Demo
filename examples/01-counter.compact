pragma language_version 0.23;
import CompactStandardLibrary;

// EXAMPLE 01 — COUNTER
// The "hello world" of Compact. Everything here is public:
// no witnesses, no private data, no disclosure decisions.
//
// Teaches: pragma, standard library import, ledger fields,
// sealed ledger, Counter ADT, constructor, exported circuits.

// `sealed` = written once in the constructor, immutable afterwards.
export sealed ledger maxRounds: Uint<16>;

// Counter is a ledger ADT: increment/decrement/read/lessThan.
export ledger round: Counter;

constructor(limit: Uint<16>) {
    assert(limit > 0, "limit must be greater than zero");
    // Constructor arguments are private inputs by default.
    // Writing one to the public ledger requires an explicit disclose().
    maxRounds = disclose(limit);
}

export circuit increment(): [] {
    assert(round.lessThan(maxRounds as Uint<64>), "round limit reached");
    round.increment(1);
}

// A pure read. Note: public ledger state is also directly queryable
// off-chain via the indexer — only export read circuits when another
// circuit or contract needs the value inside a proof.
export circuit currentRound(): Uint<64> {
    return round.read();
}
