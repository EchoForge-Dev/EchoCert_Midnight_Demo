pragma language_version 0.23;
import CompactStandardLibrary;

// EXAMPLE 02 — AGE CREDENTIAL (EchoID direction)
// Prove "I am at least N years old" without revealing the birth year.
// The birth year lives only in the holder's local witness; the ledger
// records a commitment, never the underlying data.
//
// Teaches: witness functions, asserting over private data,
// persistentCommit as an unlinkable identifier, what NOT to disclose.

export sealed ledger minAge: Uint<8>;

// Commitments of holders who passed the check.
// The birth year itself never appears on the ledger.
export ledger verified: Set<Bytes<32>>;

// Witnesses are resolved locally by the holder's own DApp —
// their return values never leave the holder's machine in the clear.
witness birthYear(): Uint<16>;
witness holderSecret(): Bytes<32>;

constructor(threshold: Uint<8>) {
    assert(threshold > 0, "threshold must be greater than zero");
    minAge = disclose(threshold);
}

// currentYear is supplied by the caller. In production, anchor it to a
// trusted time source (e.g. a block-time oracle) — a caller could lie.
export circuit proveAge(currentYear: Uint<16>): [] {
    const birth = birthYear();
    // Addition instead of subtraction: no underflow case to reason about.
    // The assert runs inside the proof; `birth` is never revealed.
    assert(birth + minAge <= currentYear, "age requirement not met");

    const holderId = holderCommitment(holderSecret());
    assert(!verified.member(holderId), "holder already verified");
    // A commitment keyed by the holder's secret hides the secret,
    // so inserting it does not require disclose().
    verified.insert(holderId);
}

circuit holderCommitment(secret: Bytes<32>): Bytes<32> {
    return persistentCommit<Bytes<32>>(pad(32, "echo:age:v1"), secret);
}
